{
  "version": 2,
  "public": false,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/[...path].js" },
    { "src": "/(.+\\.(js|css|svg|webp|png|jpg|jpeg|ico|json))", "dest": "/public/$1" },
    { "src": "/team/(.*)", "dest": "/public/team/$1" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ]
}
